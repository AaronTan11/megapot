# MegaPot Deployment Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# DEPLOYER CONFIGURATION
# =============================================================================

# Private key of the deployer account (without 0x prefix works too)
DEPLOYER_PRIVATE_KEY=0x...

# =============================================================================
# NETWORK CONFIGURATION
# =============================================================================

# MegaETH RPC URL
MEGAETH_RPC_URL=https://rpc.megaeth.example

# =============================================================================
# VRF CONFIGURATION (Required for MegaPot deployment)
# =============================================================================

# Chainlink VRF v2.5 Coordinator address
# See: https://docs.chain.link/vrf/v2-5/supported-networks
VRF_COORDINATOR=0x...

# VRF Key Hash (gas lane) - determines max gas price for VRF request
# See: https://docs.chain.link/vrf/v2-5/supported-networks
VRF_KEY_HASH=0x...

# VRF Subscription ID from https://vrf.chain.link/
VRF_SUBSCRIPTION_ID=123

# Minimum block confirmations before VRF fulfillment (1-200)
# Higher = more secure but slower
VRF_MIN_CONFIRMATIONS=3

# Gas limit for VRF callback (100,000 - 2,500,000)
# Must be enough to handle payout to all winners
VRF_CALLBACK_GAS_LIMIT=500000

# =============================================================================
# TOKEN CONFIGURATION
# =============================================================================

# USDm token address (deploy mock for testnet, use real for mainnet)
USDM_ADDRESS=0x...

# Initial mint amount for mock USDm deployment (in smallest units, 6 decimals)
# 1,000,000 USDm = 1000000000000
INITIAL_MINT_AMOUNT=1000000000000

# =============================================================================
# GAME CONFIGURATION (Optional - defaults shown)
# =============================================================================

# Round duration in seconds
# 60 = 1 minute, 300 = 5 minutes, 600 = 10 minutes
ROUND_DURATION=300

# Platform fee in basis points (1 bp = 0.01%)
# 500 = 5%, 1000 = 10%, 2000 = 20% (max)
PLATFORM_FEE_BPS=500

# Price per number in USDm smallest units (6 decimals)
# 1000000 = $1, 5000000 = $5
NUMBER_PRICE=1000000

# =============================================================================
# VERIFICATION (Optional)
# =============================================================================

# Block explorer API key for contract verification
ETHERSCAN_API_KEY=...

