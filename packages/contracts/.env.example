# MegaPot Deployment Environment Variables
# Copy this file to .env and fill in your values

# =============================================================================
# DEPLOYER CONFIGURATION
# =============================================================================

# Private key of the deployer account (without 0x prefix works too)
DEPLOYER_PRIVATE_KEY=0x...

# =============================================================================
# NETWORK CONFIGURATION (MegaETH Timothy Testnet)
# =============================================================================

# MegaETH Testnet RPC URL
# See: https://docs.megaeth.com/
MEGAETH_RPC_URL=https://carrot.megaeth.com/rpc

# Chain ID: 6342 (MegaETH Testnet)

# =============================================================================
# GELATO VRF CONFIGURATION (Required for MegaPot deployment)
# =============================================================================

# Gelato VRF Operator address (dedicated msg.sender for VRF callbacks)
# How to get:
#   1. Deploy MegaPot first with a placeholder address
#   2. Create VRF task at https://app.gelato.network/
#   3. Get the dedicated msg.sender from Gelato dashboard
#   4. Call setOperator() on MegaPot with this address
#
# See: https://docs.gelato.network/web3-services/vrf
GELATO_OPERATOR=0x...

# =============================================================================
# TOKEN CONFIGURATION
# =============================================================================

# USDm token address (deploy mock for testnet, use real for mainnet)
USDM_ADDRESS=0x...

# Initial mint amount for mock USDm deployment (in smallest units, 6 decimals)
# 1,000,000 USDm = 1000000000000
INITIAL_MINT_AMOUNT=1000000000000

# =============================================================================
# GAME CONFIGURATION (Optional - defaults shown)
# =============================================================================

# Round duration in seconds
# 60 = 1 minute, 300 = 5 minutes, 600 = 10 minutes
ROUND_DURATION=300

# Platform fee in basis points (1 bp = 0.01%)
# 500 = 5%, 1000 = 10%, 2000 = 20% (max)
PLATFORM_FEE_BPS=500

# Price per number in USDm smallest units (6 decimals)
# 1000000 = $1, 5000000 = $5
NUMBER_PRICE=1000000

# =============================================================================
# VERIFICATION (Optional)
# =============================================================================

# Block explorer API key for contract verification
# MegaETH Explorer: https://megaexplorer.xyz
ETHERSCAN_API_KEY=...
